#!/usr/bin/env python3
"""
kosync - sync KOReader reading metadata from a Kindle into a Calibre library.

Reads KOReader sidecars (*.sdr/*.lua) and settings/statistics.sqlite3 off a
Kindle mounted over MTP, matches each book to a Calibre library entry, and
writes progress, status, dates, reading time, highlights and bookmarks into
Calibre custom columns.

Usage:
    kosync                # sync everything
    kosync --dry-run      # show what would change, write nothing
    kosync --no-add       # never import unmatched sideloaded books
    kosync -v             # per-book detail
"""

